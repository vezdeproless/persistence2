{
  "settings": {
    "index": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "mapping.total_fields.limit": 1000
    }
  },
  "mappings": {
    "dynamic": true,
    "properties": {
      "@timestamp": {
        "type": "date",
        "format": "strict_date_optional_time||yyyy-MM-dd'T'HH:mm:ss"
      },
      "host.name": {
        "type": "keyword"
      },
      "reg.key.path": {
        "type": "keyword",
        "ignore_above": 8192
      },
      "reg.key.name": {
        "type": "keyword",
        "ignore_above": 8192
      },
      "file.name": {
        "type": "keyword",
        "ignore_above": 8192
      },
      "file.path": {
        "type": "keyword",
        "ignore_above": 8192
      }
    }
  }
}
